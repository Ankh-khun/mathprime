@0,1 header Warmtebalans · {bestand}
@0,2 footer {datum} · pagina {pagina} van {paginas}
@0,4 # Warmtebalans van een warmtewisselaar
@0,7 " Warme stroom geeft warmte af aan koude stroom; geen verliezen naar de omgeving.
@0,10 ## Warme kant
@0,12 m.w := 0.5 kg/s
@22,12 c.w := 4.18 kJ/(kg*K)
@0,14 T.w.in := 90 °C
@22,14 T.w.uit := 60 °C
@0,16 Q := m.w * c.w * (T.w.in - T.w.uit)
@40,16 Q = kW
@0,19 ## Koude kant
@0,21 m.k := 0.8 kg/s
@22,21 c.k := 4.18 kJ/(kg*K)
@0,23 T.k.in := 15 °C
@0,25 T.k.uit := T.k.in + Q / (m.k * c.k)
@40,25 T.k.uit = °C
@0,28 ## Gemiddeld temperatuurverschil (tegenstroom)
@0,30 ΔT.1 := T.w.in - T.k.uit
@30,30 ΔT.2 := T.w.uit - T.k.in
@0,32 ΔT.lm := (ΔT.1 - ΔT.2) / ln(ΔT.1 / ΔT.2)
@40,32 ΔT.lm = K
