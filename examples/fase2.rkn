# Nieuw in fase 2: programma's, eigenwaarden, oplossers, verdelingen, regressie en odesolve

" Programmablok: aantal stappen van het Collatz-vermoeden
stappen(n) := {
    k := 0
    while n != 1
        if mod(n, 2) == 0
            n := n / 2
        else
            n := 3 * n + 1
        k := k + 1
    k
}
stappen(27) =

" Eigenfrequenties van twee massa's aan twee veren
k := 1000 N/m
m.1 := 2 kg
K := [2 k, -k; -k, k]
M := [m.1, 0 kg; 0 kg, m.1]
f := sqrt(eigenvals(M^-1 * K)) / (2 π)
f = Hz

" Knik van een staaf (ingeklemd en scharnierend): kleinste oplossing van tan(z) = z voorbij π
z.1 := root(tan(z) - z, z, 4, 4.6)
z.1 =
E := 210 GPa
I := 2e6 mm^4
L := 3 m
F.k := z.1^2 * E * I / L^2
F.k = kN

" Solve block: twee steunpuntsreacties uit evenwicht van krachten en momenten
F.1 := 1 kN
F.2 := 1 kN
Given
F.1 + F.2 == 10 kN
F.1 * 2 m == F.2 * 3 m
Find(F.1, F.2) = kN

" Regressie: veerstijfheid uit metingen
x.m := [0, 1, 2, 3, 4] mm
F.m := [0.1, 2.1, 3.9, 6.1, 8.0] N
slope(x.m, F.m) = N/mm

" Normale verdeling: kans dat een maat boven de tolerantie valt (gemiddeld 10 mm, σ = 0.1 mm)
1 - pnorm(10.2 mm, 10 mm, 0.1 mm) =

" Gedempte trilling met odesolve
ω.0 := 10 rad/s
ζ := 0.1
Given
u''(t) + 2 ζ ω.0 u'(t) + ω.0^2 u(t) == 0
u(0 s) == 10 mm
u'(0 s) == 0 m/s
u := odesolve(t, 2 s)
u(1 s) = mm
