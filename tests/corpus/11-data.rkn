" regress: exacte parabool 1 + 2x + 3x^2
vx := [-1; 0; 1; 2; 3]
vy := [2; 1; 6; 17; 34]
interp(regress(vx, vy, 2), vx, vy, 1.5) =     // verwacht: 10.75
" polyfit geeft de coëfficiënten oplopend
c := polyfit(vx, vy, 2)
c[2] =                                        // verwacht: 3
" lopende mediaan haalt de uitschieter 99 weg
m := medsmooth([1; 2; 99; 4; 5], 3)
m[2] =                                        // verwacht: 4
" lokale maxima: indices 1 en 4
k := localmax([0; 3; 1; 1; 5; 2])
k[1] =                                        // verwacht: 4
" gladmaken van een constante blijft die constante
g := ksmooth([0; 1; 2], [7; 7; 7], 1)
g[1] =                                        // verwacht: 7
" lineaire regressie
slope([0; 1; 2; 3], [1; 3; 5; 7]) =            // verwacht: 2
