" Bessel van halftallige orde: J½(1) = √(2/π)·sin 1
Jn(0.5, 1) =                                    // verwacht: 0.671397
" bolfunctie j0(x) = sin x / x
js(0, 2) =                                      // verwacht: 0.454649
" Airy (Abramowitz & Stegun, tabel 10.11)
Ai(1) =                                         // verwacht: 0.135292
Bi(-2) =                                        // verwacht: -0.412303
" randwaardeprobleem y'' = -y, y(0) = 0, y(π/2) = 1 zonder Given: y'(0) = 1
D(x, y) := [y[1]; -y[0]]
load(x1, v) := [0; v[0]]
score(x2, y) := y[0] - 1
s := sbval([0.5], 0, π/2, D, load, score)
s[0] =                                          // verwacht: 1
" Jacobiaan van [x^2 y; 5x + sin y] in (1, 2): eerste kolom 2xy = 4 en 5
F(v) := [v[0]^2 * v[1]; 5 * v[0] + sin(v[1])]
J := Jacob(F, [1; 2])
J[0, 0] =                                       // verwacht: 4
J[1, 0] =                                       // verwacht: 5
